# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL the frontend calls for all API requests (must include /api suffix)
VITE_API_URL=http://localhost:5000/api

# Base server URL (no /api suffix) — used for eBay OAuth connect redirects and
# seller profile links that need the raw server origin
VITE_SERVER_URL=http://localhost:5000

